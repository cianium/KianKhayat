---
import Layout from "../layouts/Layout.astro";
---
<Layout page="404">
<main class="page active" id="page-404">
<div class="page-404">
<div>
<div aria-hidden="true" class="notfound-num">404</div>
<h1 class="notfound-title">Page not found.</h1>
<p class="notfound-desc">This URL doesn't exist — or not yet.</p>
<div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;">
<button class="btn btn-primary" data-nav="home">← Back to Home</button>
<button class="btn btn-outline" data-nav="contact">Contact Kian</button>
</div>
</div>
</div>
</main>
</Layout>
