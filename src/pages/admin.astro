---
import Layout from '../layouts/Layout.astro';
import {admin} from '../data/admin';
---
<Layout page="admin" title={admin.title} description={admin.intro}>
  <main class="page active" id="page-admin" data-no-translate>
    <div class="container admin-page">
      <a class="project-link" href="/">{admin.back}</a>
      <header><h1>{admin.title}</h1><p>{admin.intro}</p></header>
      <section class="admin-entry" aria-label={admin.title}>
        <a class="btn btn-primary" href="https://app.pagescms.org/" rel="noopener noreferrer">{admin.login} <span aria-hidden="true">↗</span></a>
        <p>{admin.note}</p>
        <ul>{admin.groups.map(group=><li>{group}</li>)}</ul>
      </section>
      <section class="admin-setup"><h2>{admin.setup}</h2><ol>{admin.steps.map(step=><li>{step}</li>)}</ol><p>{admin.publishing}</p></section>
    </div>
  </main>
  <style>
    .admin-page {max-width:880px;padding-block:120px 64px;}
    header {margin-block:28px;}
    h1 {font-size:clamp(2rem,5vw,3rem);line-height:1.3;margin-block:16px;}
    p,li {line-height:1.9;overflow-wrap:anywhere;}
    p {margin-block:16px;color:var(--text-2);}
    .admin-entry,.admin-setup {padding:24px;border:2px solid var(--line);border-radius:8px;background:var(--surface);margin-block:24px;box-shadow:4px 4px 0 var(--line);}
    ul,ol {padding-inline-start:24px;}li {margin-block:12px;}
    h2 {font-size:1.4rem;}.btn-primary {min-height:48px;text-decoration:none;}
    @media(max-width:600px){.admin-page {padding-top:108px;}.admin-entry,.admin-setup {padding:20px;}}
  </style>
</Layout>
