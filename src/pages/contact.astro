<div class="contact-form fade-up">
<form id="contact-form-wrap" novalidate>
<input type="text" name="website" autocomplete="off" tabindex="-1" hidden aria-hidden="true"/>
<h3 class="form-title">Send a Message</h3>
<div class="form-group">
<label class="form-label" for="cf-name">Name</label>
<input autocomplete="name" class="form-input" id="cf-name" name="name" maxlength="120" aria-describedby="cf-name-err" placeholder="Your name" type="text"/>
<div class="form-error" id="cf-name-err">Please enter your name.</div>
</div>
<div class="form-group">
<label class="form-label" for="cf-email">Email</label>
<input autocomplete="email" class="form-input" id="cf-email" dir="ltr" name="email" maxlength="254" aria-describedby="cf-email-err" placeholder="you@example.com" type="email"/>
<div class="form-error" id="cf-email-err">Please enter a valid email.</div>
</div>
<div class="form-group">
<label class="form-label" for="cf-subject">Subject</label>
<input class="form-input" id="cf-subject" name="subject" maxlength="200" aria-describedby="cf-subject-err" placeholder="What's on your mind?" type="text"/>
<div class="form-error" id="cf-subject-err">Please add a subject.</div>
</div>
<div class="form-group">
<label class="form-label" for="cf-msg">Message</label>
<textarea class="form-textarea" id="cf-msg" name="message" maxlength="5000" aria-describedby="cf-msg-err" placeholder="Your message…"></textarea>
<div class="form-error" id="cf-msg-err">Please write a message.</div>
</div>
<button class="submit-btn" id="submit-btn" type="submit">
<span id="submit-text">Send Message</span>
<span id="submit-icon">→</span>
</button>
</form>
<p id="form-error" role="alert" hidden></p>
<div role="status" class="form-success" id="form-success">
<div class="success-icon">✅</div>
<div class="success-title">Message sent.</div>
<p class="success-msg">Thanks for reaching out. I'll get back to you within 24 hours.</p>
</div>
</div>
</div>
