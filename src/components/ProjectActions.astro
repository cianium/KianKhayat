---
import {siteLanguage} from '../data/sites';
import {ui} from '../data/interface';
interface Props {liveUrl?: string; githubUrl?: string}
const {liveUrl, githubUrl} = Astro.props;
---
<div class="project-actions" data-no-translate>
  {githubUrl && <a class="project-link" href={githubUrl} target="_blank" rel="noopener noreferrer">{ui('github',siteLanguage)} <span aria-hidden="true">↗</span></a>}
  {liveUrl && <a class="project-link primary" href={liveUrl} target="_blank" rel="noopener noreferrer">{ui('live',siteLanguage)} <span aria-hidden="true">↗</span></a>}
</div>
