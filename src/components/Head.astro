---
import {languages, languageURL, siteLanguage, siteOrigin} from '../data/sites';
import {seo, type Page} from '../data/seo';
interface Props {page: string; title?: string; description?: string; image?: string; article?: {headline:string;publishedAt?:string;categories:string[];language?:string;updatedAt?:string}}
const page = Astro.props.page as Page;
const title=Astro.props.title ?? seo[page][0];
const description=Astro.props.description ?? seo[page][1];
const canonical = languageURL(Astro.props.article ? (languages.find(lang=>lang===Astro.props.article?.language?.split('-')[0])||'en') : siteLanguage, Astro.url.pathname);
const image = new URL(Astro.props.image || '/photo.jpg',siteOrigin).href;
const article=Astro.props.article;
const noindex=page==='404'||Astro.props.page==='admin';
const graph = [
  {'@type': 'WebSite', '@id': `${siteOrigin}/#website`, url: `${siteOrigin}/`, name: seo.name, inLanguage: siteLanguage, publisher: {'@id': 'https://kiankhayat.me/#person'}},
  {'@type': 'Person', '@id': 'https://kiankhayat.me/#person', name: seo.name, alternateName: siteLanguage === 'fa' ? ['کیان'] : ['Kian', 'Cian'], url: 'https://kiankhayat.me/', image: `${siteOrigin}/photo.jpg`, description: seo.home[1], sameAs: ['https://github.com/cianium', 'https://instagram.com/empersiian', 'https://x.com/empersiian', 'https://www.linkedin.com/in/kian-khayat-5a41b4439']},
  {'@type': page === 'contact' ? 'ContactPage' : 'WebPage', '@id': `${canonical}#webpage`, url: canonical, name: title, description, inLanguage: article?.language ?? siteLanguage, isPartOf: {'@id': `${siteOrigin}/#website`}, about: {'@id': 'https://kiankhayat.me/#person'}},
  ...(article?[{'@type':'Article','@id':`${canonical}#article`,url:canonical,headline:article.headline,description,inLanguage:article.language ?? siteLanguage,
    mainEntityOfPage:{'@id':`${canonical}#webpage`},author:{'@type':'Person','@id':'https://kiankhayat.me/#person',name:seo.name,url:'https://kiankhayat.me/'},
    articleSection:article.categories,...(article.publishedAt?{datePublished:article.publishedAt}:{}),...(article.updatedAt?{dateModified:article.updatedAt}:{}),...(Astro.props.image?{image:[image]}:{})}]:[]),
];
---
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>{title}</title>
<meta content={description} name="description"/>
{noindex ? <meta name="robots" content="noindex, follow"/> : <>
  <link rel="canonical" href={canonical}/>
  {!article && languages.map(lang => <link rel="alternate" hreflang={lang} href={languageURL(lang, Astro.url.pathname)}/>)}
  {!article && <link rel="alternate" hreflang="x-default" href={languageURL('en', Astro.url.pathname)}/>}
</>}
<meta content="#f8f4ec" name="theme-color" media="(prefers-color-scheme: light)"/>
<meta content="#241d18" name="theme-color" media="(prefers-color-scheme: dark)"/>
<meta content={seo.name} property="og:site_name"/>
<meta content={title} property="og:title"/>
<meta content={description} property="og:description"/>
<meta content={article ? ({en:'en_US',de:'de_DE',fa:'fa_IR'}[article.language?.split('-')[0] as 'en'|'de'|'fa'] || article.language) : seo.locale} property="og:locale"/>
<meta content={article?'article':'website'} property="og:type"/>
{article?.publishedAt && <meta property="article:published_time" content={article.publishedAt}/>}
<meta content={canonical} property="og:url"/>
<meta content={image} property="og:image"/>
<meta content={seo.name} property="og:image:alt"/>
<meta content="summary_large_image" name="twitter:card"/>
<meta content={title} name="twitter:title"/>
<meta content={description} name="twitter:description"/>
<meta content={image} name="twitter:image"/>
<meta content={seo.name} name="twitter:image:alt"/>
<link href="/favicon.svg" rel="icon" type="image/svg+xml"/>
<link href="/favicon-48x48.png" rel="icon" sizes="48x48" type="image/png"/>
<link href="/favicon-96x96.png" rel="icon" sizes="96x96" type="image/png"/>
<link href="/icon-192.png" rel="icon" sizes="192x192" type="image/png"/>
<link href="/favicon.ico" rel="shortcut icon"/>
<link href="/apple-touch-icon.png" rel="apple-touch-icon"/>
<link href="/site.webmanifest" rel="manifest"/>
<link rel="alternate" type="application/rss+xml" title={seo.articles[0]} href={`${siteOrigin}/rss.xml`}/>
<link href="https://fonts.googleapis.com" rel="preconnect"/>
<link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
<link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@300;400;500;600;700;800&amp;family=Inter:wght@300;400;500;600&amp;family=JetBrains+Mono:wght@400;500&amp;family=Vazirmatn:wght@300;400;500;600;700&amp;display=swap" rel="stylesheet"/>
{!noindex && <script type="application/ld+json" set:html={JSON.stringify({'@context': 'https://schema.org', '@graph': graph}).replace(/</g, '\\u003c')}/>}
