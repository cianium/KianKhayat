<div aria-labelledby="skill-modal-title" aria-modal="true" class="modal-overlay" id="skill-modal" data-overlay="skill-modal" role="dialog">
<div class="modal" id="skill-modal-inner">
<div class="modal-header">
<div>
<div class="card-label" id="skill-modal-cat"></div>
<h2 class="h3" id="skill-modal-title"></h2>
</div>
<button aria-label="Close modal" class="modal-close" data-close="skill-modal">✕</button>
</div>
<div class="modal-body">

<div class="skill-modal-ring">
<svg aria-hidden="true" viewBox="0 0 120 120">
<circle class="ring-bg" cx="60" cy="60" r="47"></circle>
<circle class="ring-fill" cx="60" cy="60" id="modal-ring-fill" r="47"></circle>
</svg>
<div class="skill-modal-pct-wrap">
<span class="skill-modal-pct" id="skill-modal-pct"></span>
</div>
</div>
<p id="skill-modal-desc" style="text-align:center;color:var(--text-2);font-size:0.9rem;margin-bottom:20px;"></p>
<div class="skill-detail-grid" id="skill-modal-details"></div>
<div style="margin-top:24px;">
<div class="card-label" style="margin-bottom:10px;">Learning path</div>
<div id="skill-modal-path" style="font-size:0.875rem;color:var(--text-2);line-height:1.7;"></div>
</div>
</div>
</div>
</div>
<div aria-labelledby="article-modal-title" aria-modal="true" class="modal-overlay" id="article-modal" data-overlay="article-modal" role="dialog">
<div class="modal" style="max-width:700px;">
<div class="modal-header">
<div>
<div class="card-label" id="article-modal-cat"></div>
<h2 class="h3" id="article-modal-title"></h2>
<div id="article-modal-meta" style="font-size:0.75rem;font-family:var(--font-mono);color:var(--text-2);margin-top:6px;"></div>
</div>
<button aria-label="Close modal" class="modal-close" data-close="article-modal">✕</button>
</div>
<div class="modal-body">
<div class="article-content" id="article-modal-content"></div>
</div>
</div>
</div>
<div aria-labelledby="cert-modal-title" aria-modal="true" class="modal-overlay" id="cert-modal" data-overlay="cert-modal" role="dialog">
<div class="modal cert-lightbox">
<div class="modal-header">
<div>
<div class="card-label" id="cert-modal-cat"></div>
<h2 class="h3" id="cert-modal-title"></h2>
</div>
<button aria-label="Close modal" class="modal-close" data-close="cert-modal">✕</button>
</div>
<div class="modal-body">
<div aria-label="Certificate preview" class="cert-lightbox-img" id="cert-modal-img"></div>
<p id="cert-modal-desc" style="font-size:0.875rem;color:var(--text-2);line-height:1.65;margin-bottom:12px;"></p>
<div style="display:flex;gap:12px;font-size:0.8rem;font-family:var(--font-mono);color:var(--text-2);margin-bottom:16px;">
<span id="cert-modal-issuer"></span>
<span>·</span>
<span id="cert-modal-date"></span>
</div>
<div class="cert-lightbox-actions">
<button class="cert-lb-btn" data-close="cert-modal">← Back</button>
<button class="cert-lb-btn primary" disabled>⬇ Download</button>
</div>
<div class="cert-file-actions" id="cert-file-actions"></div>
</div>
</div>
</div>
