---
import {localized} from "../data/localized";
import { getCollection } from 'astro:content';
import ProjectCover from './ProjectCover.astro';
import ProjectActions from './ProjectActions.astro';
import {siteLanguage} from '../data/sites';
import {localizedProjectStatus} from '../data/project-status';
const projects = (await getCollection('projects')).sort((a,b) => a.data.order-b.data.order);
---
{projects.map(({data:p}) => <article class="project-card fade-up">
  <a href={`/work/${p.slug}/`} tabindex="-1" aria-hidden="true"><ProjectCover thumbnail={p.thumbnail} title={p.title} emoji={p.emoji}/></a>
  <div class="project-body">
    <div class="project-tags">{p.tags.map(tag => <span class="project-tag">{tag}</span>)} <span class="tag-primary" data-localized={localized(p.status,localizedProjectStatus(p.status,'de'),localizedProjectStatus(p.status,'fa'))}>{localizedProjectStatus(p.status,siteLanguage)}</span></div>
    <h2 class="project-title"><a href={`/work/${p.slug}/`} data-localized={localized(p.title,p.translations.de?.title,p.translations.fa?.title)}>{p.title}</a></h2>
    <div class="project-desc" data-localized={localized(p.summary,p.translations.de?.summary,p.translations.fa?.summary)}>{p.summary}</div>
    <div class="project-footer"><ProjectActions liveUrl={p.liveUrl} githubUrl={p.githubUrl}/></div>
  </div>
</article>)}
